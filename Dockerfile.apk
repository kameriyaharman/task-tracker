# Builds the Keshav Android APK (release, installable) and serves it for download.
# Railway service "keshav-apk" uses this file. Rebuilds only when mobile/ changes.

FROM reactnativecommunity/react-native-android:latest AS build
WORKDIR /app
COPY mobile/package.json mobile/package-lock.json mobile/.npmrc ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY mobile/ ./
ARG API_URL=https://keshavkunj.com/api
# Optional (diagnostic builds): alternative JS entry, app id and name
ARG APP_ENTRY=
ARG APP_ID=
ARG APP_NAME=
RUN if [ -n "$APP_ENTRY" ]; then node -e "const p=require('./package.json');p.main=process.argv[1];require('fs').writeFileSync('package.json',JSON.stringify(p,null,2))" "$APP_ENTRY"; fi \
 && if [ -n "$APP_ID" ]; then node -e "const a=require('./app.json');a.expo.android.package=process.argv[1];if(process.argv[2])a.expo.name=process.argv[2];require('fs').writeFileSync('app.json',JSON.stringify(a,null,2))" "$APP_ID" "$APP_NAME"; fi
ENV EXPO_PUBLIC_API_URL=${API_URL} \
    EXPO_PUBLIC_USE_RN_FETCH=1 \
    EXPO_NO_TELEMETRY=1 \
    NODE_ENV=production \
    GRADLE_OPTS="-Dorg.gradle.jvmargs=-Xmx6g -Dorg.gradle.daemon=false -Dorg.gradle.workers.max=4"
RUN npx expo prebuild --platform android --no-install --clean
# arm64 covers practically every Android phone sold since 2017; keeps the build fast.
RUN cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a --no-daemon --stacktrace \
 && mkdir -p /out && cp app/build/outputs/apk/release/app-release.apk /out/keshav.apk

FROM node:22-alpine
WORKDIR /srv
COPY --from=build /out/keshav.apk ./keshav.apk
COPY docker/apk-server.js ./server.js
ARG APK_LABEL=
ENV APK_LABEL=${APK_LABEL}
CMD ["node", "server.js"]
